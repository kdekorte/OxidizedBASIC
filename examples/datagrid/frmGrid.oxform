{
  "name": "frmGrid",
  "caption": "DataGrid example",
  "width": 640.0,
  "height": 420.0,
  "controls": [
    {
      "name": "lblStatus",
      "kind": "Label",
      "rect": { "left": 16.0, "top": 12.0, "width": 608.0, "height": 22.0 },
      "caption": "Click a cell, or type into one. Try typing \"bad\".",
      "enabled": true,
      "visible": true,
      "font": { "name": "", "size": 12, "bold": true, "italic": false, "underline": false, "strikethrough": false }
    },
    {
      "name": "Grid1",
      "kind": "DataGrid",
      "rect": { "left": 16.0, "top": 44.0, "width": 608.0, "height": 280.0 },
      "enabled": true,
      "visible": true,
      "grid": {
        "rows": 9,
        "cols": 4,
        "fixedRows": 1,
        "fixedCols": 1,
        "editable": true,
        "row": 1,
        "col": 1,
        "cells": [
          ["", "Item", "Qty", "Note"],
          ["1", "Apples", "3", ""],
          ["2", "Bread", "1", ""],
          ["3", "Coffee", "2", ""],
          ["4", "Eggs", "12", ""],
          ["5", "Flour", "1", ""],
          ["6", "Milk", "2", ""],
          ["7", "Rice", "1", ""],
          ["8", "Tea", "4", ""]
        ],
        "colWidths": [40.0, 200.0, 120.0, 220.0],
        "rowHeights": [24.0, 24.0, 24.0, 24.0, 24.0, 24.0, 24.0, 24.0, 24.0],
        "topRow": 0,
        "leftCol": 0,
        "scrollBars": 3
      }
    },
    {
      "name": "lblEdit",
      "kind": "Label",
      "rect": { "left": 16.0, "top": 336.0, "width": 608.0, "height": 20.0 },
      "caption": "Last edit: none",
      "enabled": true,
      "visible": true,
      "font": { "name": "", "size": 11, "bold": false, "italic": false, "underline": false, "strikethrough": false }
    },
    {
      "name": "cmdAddRow",
      "kind": "CommandButton",
      "rect": { "left": 16.0, "top": 368.0, "width": 140.0, "height": 30.0 },
      "caption": "Add row",
      "enabled": true,
      "visible": true
    },
    {
      "name": "cmdFill",
      "kind": "CommandButton",
      "rect": { "left": 166.0, "top": 368.0, "width": 140.0, "height": 30.0 },
      "caption": "Fill Qty x 10",
      "enabled": true,
      "visible": true
    },
    {
      "name": "cmdClear",
      "kind": "CommandButton",
      "rect": { "left": 316.0, "top": 368.0, "width": 140.0, "height": 30.0 },
      "caption": "Clear body",
      "enabled": true,
      "visible": true
    },
    {
      "name": "cmdDone",
      "kind": "CommandButton",
      "rect": { "left": 484.0, "top": 368.0, "width": 140.0, "height": 30.0 },
      "caption": "Done",
      "enabled": true,
      "visible": true
    }
  ]
}
